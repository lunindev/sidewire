<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Sidewire</string>
	<key>CFBundleDisplayName</key>
	<string>Sidewire</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Sidewire captures the virtual display it creates so it can stream it to your other Mac.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sidewire finds and connects to your other Mac on the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_sidewire._tcp</string>
	</array>
</dict>
</plist>
