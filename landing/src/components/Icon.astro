---
// Minimal inline icon set (24×24, stroke = currentColor). Names match Feature.icon in data/site.ts.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 24 } = Astro.props;

const paths: Record<string, string> = {
  // a monitor with a "+" — a display being added
  display: '<rect x="2.5" y="4" width="19" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="M12 8v5M9.5 10.5h5"/>',
  // lightning bolt (Thunderbolt)
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>',
  // cursor / pointer
  cursor: '<path d="m4 3 7 17 2.5-6.5L20 11 4 3Z"/>',
  // speed gauge
  gauge: '<path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="m13.5 10.5 4-4"/><path d="M4.2 18a9 9 0 1 1 15.6 0"/>',
  // padlock
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/>',
  // shield
  shield: '<path d="M12 3 5 6v6c0 4.2 3 7.4 7 9 4-1.6 7-4.8 7-9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  // two devices (mac + pc)
  devices: '<rect x="2.5" y="5" width="12" height="9" rx="1.5"/><path d="M2.5 17h12"/><rect x="16.5" y="9" width="5" height="10" rx="1"/>',
  // circular refresh / reconnect
  refresh: '<path d="M20 11a8 8 0 1 0-.5 3"/><path d="M20 4v5h-5"/>',
  // github mark
  github: '<path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/>',
  // arrow-right
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
};

const inner = paths[name] ?? '';
const filled = name === 'bolt' || name === 'cursor' || name === 'github';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
