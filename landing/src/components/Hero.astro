---
import { links } from '../data/site';
import WireDiagram from './WireDiagram.astro';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="pill">
        <span class="ping" aria-hidden="true"></span>
        macOS · Thunderbolt or Wi‑Fi
      </span>

      <h1>
        Give your main Mac a second screen —
        <span class="grad">using a Mac you already own.</span>
      </h1>

      <p class="lead">
        Sidewire turns a spare Mac into a real extra display for your primary one. Not screen
        sharing — an actual desktop you drag windows onto, with your keyboard and mouse working
        across both. Over a Thunderbolt cable or your Wi‑Fi.
      </p>

      <div class="hero-cta">
        <a class="btn btn-primary" href={links.download}>
          <Icon name="arrow" size={18} />
          Watch for the v1 release
        </a>
        <a class="btn btn-ghost" href="#how">See how it works</a>
      </div>

      <p class="hero-status">
        There’s no packaged build yet — the source is open, and the release page above is where the
        first signed macOS build will land.
      </p>

      <ul class="hero-trust">
        <li>Universal 2 · macOS 14+</li>
        <li>100% local — no accounts</li>
        <li>
          <a href={links.license} target="_blank" rel="noopener">MIT‑licensed</a>
        </li>
      </ul>
    </div>

    <div class="hero-art">
      <WireDiagram />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  h1 {
    font-size: clamp(2.3rem, 5.4vw, 3.8rem);
    margin-top: 22px;
    max-width: 15ch;
  }
  .lead {
    margin-top: 22px;
    max-width: 44ch;
    font-size: clamp(1.05rem, 2.1vw, 1.22rem);
    color: var(--ink-dim);
  }
  .hero-cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero-status {
    margin-top: 18px;
    max-width: 46ch;
    font-size: 0.9rem;
    color: var(--ink-mut);
  }
  .hero-trust {
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.88rem;
    color: var(--ink-mut);
  }
  .hero-trust li {
    position: relative;
    padding-left: 16px;
  }
  .hero-trust a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .hero-trust a:hover {
    color: var(--ink);
  }
  .hero-trust li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--bolt);
  }
  .ping {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--bolt);
    box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5); }
    70%, 100% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ping { animation: none; }
  }
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
    }
    h1,
    .lead {
      max-width: none;
    }
  }
</style>
