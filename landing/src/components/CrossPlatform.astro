---
import { links } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section">
  <div class="container">
    <div class="cross card">
      <div class="cross-copy">
        <span class="eyebrow">Not just Macs</span>
        <h2>Bring a PC to the party.</h2>
        <p>
          Got a Windows or Linux laptop spare instead? It can be the extra screen too. The native
          client speaks Sidewire’s exact wire protocol — pair it with a 6‑digit PIN and it decodes,
          renders on the GPU, and forwards input just like a second Mac would.
        </p>
        <p class="cross-note">
          The one rule: the machine that <em>gains</em> the screen is always a Mac — creating a
          virtual display is macOS‑specific.
        </p>
        <a class="btn btn-ghost" href={links.github} target="_blank" rel="noopener">
          <Icon name="github" size={18} />
          See the client
        </a>
      </div>

      <ul class="cross-list">
        <li><span class="tick" aria-hidden="true"></span> Identical, byte‑exact protocol</li>
        <li><span class="tick" aria-hidden="true"></span> GPU‑accelerated decode &amp; render</li>
        <li><span class="tick" aria-hidden="true"></span> Keyboard &amp; mouse forwarding</li>
        <li><span class="tick" aria-hidden="true"></span> Discovers Macs on the LAN</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cross {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    padding: clamp(32px, 5vw, 52px);
    align-items: center;
    background:
      radial-gradient(60% 120% at 100% 0%, rgba(99, 102, 241, 0.12), transparent 60%),
      linear-gradient(180deg, var(--panel-2), var(--panel));
  }
  .cross h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.4rem);
    margin-top: 14px;
  }
  .cross-copy p {
    margin-top: 16px;
    color: var(--ink-dim);
    font-size: 1.02rem;
  }
  .cross-note {
    color: var(--ink-mut) !important;
    font-size: 0.94rem !important;
  }
  .cross-copy .btn {
    margin-top: 24px;
  }
  .cross-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .cross-list li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.96rem;
    color: var(--ink);
  }
  .tick {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--accent-grad);
    position: relative;
  }
  .tick::after {
    content: "";
    position: absolute;
    left: 5.5px;
    top: 3px;
    width: 4px;
    height: 8px;
    border: solid #06121b;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  @media (max-width: 820px) {
    .cross {
      grid-template-columns: 1fr;
    }
  }
</style>
