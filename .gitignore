# macOS
.DS_Store

# Xcode / SwiftPM build artifacts
DerivedData/
build/
.build/
.swiftpm/
*.xcuserstate
*.moved-aside
*.swp
xcuserdata/

# Generated by XcodeGen — regenerate with `xcodegen generate`
*.xcodeproj

# The local packages' Package.resolved files. These are libraries consumed only by the app target,
# and SwiftPM ignores a dependency's resolved file — only the root's counts — so they have no
# authority over what actually ships. Worse, they provably oscillate: `swift test` resolves the
# package alone and drops Sparkle, `xcodebuild` resolves the whole project and writes it back, so
# whichever version is committed leaves someone with a spurious diff. The app's real lock is the
# exact Sparkle pin in app/project.yml.
app/Packages/*/Package.resolved

# IDEs
.idea/
.vscode/

# Release artifacts (Developer ID DMG, notarization staging) — also covers landing/dist (Astro output)
dist/

# Node / Astro (landing/)
node_modules/
.astro/
*.tsbuildinfo
.env
.env.*
!.env.example
npm-debug.log*
pnpm-debug.log*

# ── Signing material — never commit any of this ────────────────────────────────
# Backstop only: the real rule is that certificates, private keys and notarization
# credentials live in your keychain or in CI secrets, never in the tree.
*.p12
*.pem
*.cer
*.mobileprovision
AuthKey_*.p8
*_ed_key

# Rust build output. app/clients/sidewire-viewer/.gitignore already covers its own
# target/; this root-level rule is cheap insurance against a stray one anywhere else.
target/
