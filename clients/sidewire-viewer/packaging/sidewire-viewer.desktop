[Desktop Entry]
Type=Application
Version=1.0
Name=Sidewire Viewer
GenericName=Extended Display Client
Comment=Use this PC as a wireless/wired extended display for a Mac (Sidewire Display client)
# The Display is a listener/server: launched with no args it listens on port 5005, advertises
# _sidewire._tcp over mDNS, and opens the video window once a Mac Source connects.
Exec=sidewire-viewer
Icon=sidewire-viewer
Terminal=false
Categories=Utility;Network;RemoteAccess;
Keywords=display;screen;remote;mac;sidewire;extend;
StartupNotify=true
